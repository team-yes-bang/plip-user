# Docker Compose / 로컬 공통 (Git 커밋 금지 — .gitignore 의 .env)
DB_USERNAME=root
DB_PASSWORD=changeme

# 앱/DB 포트 (호스트에 노출)
SERVER_PORT=8080
MYSQL_PORT=3308

# MySQL 스키마명 — 서비스별로 변경 (예: plip_agit)
MYSQL_DATABASE=plip_user

# 로컬 Docker Compose 전용 — Compose가 app 컨테이너에 redis/kafka 호스트명을 주입
# 호스트 IDE bootRun 시: localhost + 아래 포트 (infra 컨테이너만 띄운 경우)
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# JWT (로컬 개발용 — 운영은 시크릿 관리 체계 사용)
JWT_SECRET=change-me-local-dev-only

# Resend 이메일 API (https://resend.com 에서 발급)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@plip.app
